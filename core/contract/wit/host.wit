// Draft contract (0.x). Contract 1.0 is designed in the socle plan.
package vehicoule:host@0.1.0;

interface http {
    record request {
        method: string,
        url: string,
        headers: list<tuple<string, string>>,
        body: option<list<u8>>,
    }

    record response {
        status: u16,
        headers: list<tuple<string, string>>,
        body: list<u8>,
    }

    variant http-error {
        network(string),
        too-large,
        timeout,
    }

    send: func(req: request) -> result<response, http-error>;
}

world probe {
    import http;
    export run: func(input: string) -> result<string, string>;
}
