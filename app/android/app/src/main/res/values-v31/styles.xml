<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: the system splash plays the Mochi (drawable/splash_mochi.xml) on the
     icon's background, in light and dark alike; MainActivity fades it out. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_mochi</item>
        <item name="android:windowSplashScreenAnimationDuration">700</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
