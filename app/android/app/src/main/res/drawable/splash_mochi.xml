            </objectAnimator>
        </aapt:attr>
    </target>
    <target android:name="squash">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator android:duration="80" android:startOffset="300" android:interpolator="@android:interpolator/decelerate_quad">
                    <propertyValuesHolder android:propertyName="scaleX" android:valueFrom="1" android:valueTo="1.1" android:valueType="floatType" />
                    <propertyValuesHolder android:propertyName="scaleY" android:valueFrom="1" android:valueTo="0.86" android:valueType="floatType" />
                </objectAnimator>
                <objectAnimator android:duration="120" android:startOffset="0" android:interpolator="@android:interpolator/fast_out_slow_in">
                    <propertyValuesHolder android:propertyName="scaleX" android:valueFrom="1.1" android:valueTo="0.96" android:valueType="floatType" />
                    <propertyValuesHolder android:propertyName="scaleY" android:valueFrom="0.86" android:valueTo="1.06" android:valueType="floatType" />
                </objectAnimator>
                <objectAnimator android:duration="100" android:startOffset="0" android:interpolator="@android:interpolator/fast_out_slow_in">
                    <propertyValuesHolder android:propertyName="scaleX" android:valueFrom="0.96" android:valueTo="1" android:valueType="floatType" />
                    <propertyValuesHolder android:propertyName="scaleY" android:valueFrom="1.06" android:valueTo="1" android:valueType="floatType" />
                </objectAnimator>
            </set>
        </aapt:attr>
